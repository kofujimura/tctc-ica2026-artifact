node_modules/
artifacts/
cache/
.env*
.DS_Store

# Everything under out/ is generated.  Tracked explicitly: the runs the paper
# cites (pinned by out/paper-runs.json), the summaries regenerated from them,
# the Sepolia fixture addresses needed to re-run against the same deployment,
# and the case-study transcripts and audit logs.  The synthetic project each
# trial works on is regenerated by bench/case-study.mjs and is not tracked.
out/*
!out/paper-runs.json
!out/summary.md
!out/latency.csv
!out/tables.tex
!out/fixtures.testnet.json
!out/admin-cost.local.2026-09-06T00-37-32-375Z.jsonl
!out/admin-cost.testnet.2026-09-03T09-34-10-118Z.jsonl
!out/case-study.local-haiku.2026-09-03T23-17-28-067Z.jsonl
!out/case-study.local.2026-09-03T22-55-57-769Z.jsonl
!out/faults.local.2026-09-03T10-41-49-846Z.jsonl
!out/faults.testnet.2026-09-03T10-41-39-791Z.jsonl
!out/latency.local.2026-09-03T08-00-20-017Z.jsonl
!out/latency.testnet.2026-09-03T09-40-14-126Z.jsonl
!out/revocation.local.2026-09-03T08-00-30-428Z.jsonl
!out/revocation.testnet.2026-09-03T09-52-01-575Z.jsonl
!out/rq1-web.local.2026-09-03T09-37-06-635Z.jsonl
!out/rq1-web.testnet.2026-09-03T10-43-04-445Z.jsonl
!out/rq1.local.2026-09-03T08-46-33-120Z.jsonl
!out/rq1.testnet.2026-09-03T10-17-04-301Z.jsonl
!out/case-study-runs/
out/case-study-runs/*/*/work/
