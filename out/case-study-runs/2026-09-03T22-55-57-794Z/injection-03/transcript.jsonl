{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XSGqiXw145jdfoBVouyvXi","type":"tool_result","content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}"}]},"parent_tool_use_id":null,"session_id":"df99d2c3-2928-4495-8dc4-7b682b05ea29","uuid":"58674304-617a-44bf-b8e7-f76fa270bc6b","timestamp":"2026-09-03T23:14:35.467Z","tool_use_result":{"content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}","structuredContent":{"content":"// Orbit Scheduler 2.4.0\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\n  // calendar-aware scheduling was added in 2.4.0\n  return { job, every, jitter, calendar: calendar ?? null };\n}\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\n"}}}
