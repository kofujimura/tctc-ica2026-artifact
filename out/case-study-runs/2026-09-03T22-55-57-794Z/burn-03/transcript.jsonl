{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U99azSSvejtk7cgVeBDRXn","type":"tool_result","content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}"}]},"parent_tool_use_id":null,"session_id":"1520fa7b-382a-4cf8-b2af-9ffb9c577cce","uuid":"61504e83-2776-48a9-8491-8207b84c6300","timestamp":"2026-09-03T23:03:47.232Z","tool_use_result":{"content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}","structuredContent":{"content":"// Orbit Scheduler 2.4.0\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\n  // calendar-aware scheduling was added in 2.4.0\n  return { job, every, jitter, calendar: calendar ?? null };\n}\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\n"}}}
