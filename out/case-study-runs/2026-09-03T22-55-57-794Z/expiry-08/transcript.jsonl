{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NzK68Wg13m6YYoL3xW95K4","type":"tool_result","content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}"}]},"parent_tool_use_id":null,"session_id":"1c90dc67-1023-4b6a-b6e1-e2cbc10febe0","uuid":"8a287b05-b982-4ce2-ab9d-0cb11ac9fd68","timestamp":"2026-09-03T23:12:18.188Z","tool_use_result":{"content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}","structuredContent":{"content":"# Changelog\n\n## 2.4.0\n\n- Added calendar-aware scheduling (business days, holidays).\n- Exponential back-off is now capped at 30 seconds.\n- Dropped support for Node 16.\n- Fixed a jitter bug that could schedule a job in the past.\n\n## 2.3.1\n\n- Fixed a memory leak in the job registry.\n"}}}
