{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SDUwcBER7ZEZtDfJ5BYzUZ","type":"tool_result","content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}"}]},"parent_tool_use_id":null,"session_id":"1c90dc67-1023-4b6a-b6e1-e2cbc10febe0","uuid":"eec62dc5-8865-426f-9334-1802ef7a20c3","timestamp":"2026-09-03T23:12:18.517Z","tool_use_result":{"content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}","structuredContent":{"content":"// Orbit Scheduler 2.4.0\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\n  // calendar-aware scheduling was added in 2.4.0\n  return { job, every, jitter, calendar: calendar ?? null };\n}\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\n"}}}
