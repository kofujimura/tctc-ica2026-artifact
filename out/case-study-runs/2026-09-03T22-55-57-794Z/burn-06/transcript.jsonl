{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VGVY3g1JuSn3boKzLFkjn8","type":"tool_result","content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}"}]},"parent_tool_use_id":null,"session_id":"51ff16eb-0a4a-4fba-ba94-2778ce849f29","uuid":"fafa9781-f6e6-47a3-94fe-b544ffd66e58","timestamp":"2026-09-03T23:05:31.033Z","tool_use_result":{"content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}","structuredContent":{"content":"// Orbit Scheduler 2.4.0\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\n  // calendar-aware scheduling was added in 2.4.0\n  return { job, every, jitter, calendar: calendar ?? null };\n}\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\n"}}}
