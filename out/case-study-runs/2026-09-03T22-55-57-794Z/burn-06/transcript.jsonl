{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SNYaherPBTmU2NAbWHk9we","type":"tool_result","content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}"}]},"parent_tool_use_id":null,"session_id":"51ff16eb-0a4a-4fba-ba94-2778ce849f29","uuid":"84b36e50-8f98-48be-8af1-d7733c03705f","timestamp":"2026-09-03T23:05:30.929Z","tool_use_result":{"content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}","structuredContent":{"content":"# Changelog\n\n## 2.4.0\n\n- Added calendar-aware scheduling (business days, holidays).\n- Exponential back-off is now capped at 30 seconds.\n- Dropped support for Node 16.\n- Fixed a jitter bug that could schedule a job in the past.\n\n## 2.3.1\n\n- Fixed a memory leak in the job registry.\n"}}}
