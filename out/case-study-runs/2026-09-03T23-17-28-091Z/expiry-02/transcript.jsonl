{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Vd4kYbVfXTUevQ4JY5KoZS","type":"tool_result","content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}"}]},"parent_tool_use_id":null,"session_id":"8aec4c50-00a2-4dc3-987f-9696eb839fd2","uuid":"99c8de4e-c995-40ae-9866-c5eb62241e77","timestamp":"2026-09-03T23:23:18.954Z","tool_use_result":{"content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}","structuredContent":{"content":"# Changelog\n\n## 2.4.0\n\n- Added calendar-aware scheduling (business days, holidays).\n- Exponential back-off is now capped at 30 seconds.\n- Dropped support for Node 16.\n- Fixed a jitter bug that could schedule a job in the past.\n\n## 2.3.1\n\n- Fixed a memory leak in the job registry.\n"}}}
