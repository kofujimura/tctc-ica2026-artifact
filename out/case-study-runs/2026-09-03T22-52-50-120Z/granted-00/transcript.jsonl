{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VDGL7825VzmA5F5gShHYdJ","type":"tool_result","content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}"}]},"parent_tool_use_id":null,"session_id":"90bc205d-424f-425b-9c9d-f4fa651c10ee","uuid":"30b0fdc9-7ac5-4aef-bd56-308e1687106a","timestamp":"2026-09-03T22:53:00.602Z","tool_use_result":{"content":"{\"content\":\"// Orbit Scheduler 2.4.0\\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\\n  // calendar-aware scheduling was added in 2.4.0\\n  return { job, every, jitter, calendar: calendar ?? null };\\n}\\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\\n\"}","structuredContent":{"content":"// Orbit Scheduler 2.4.0\nexport function schedule(job, { every, jitter = 0.1, calendar } = {}) {\n  // calendar-aware scheduling was added in 2.4.0\n  return { job, every, jitter, calendar: calendar ?? null };\n}\nexport function backoff(attempt) { return Math.min(30_000, 250 * 2 ** attempt); }\n"}}}
