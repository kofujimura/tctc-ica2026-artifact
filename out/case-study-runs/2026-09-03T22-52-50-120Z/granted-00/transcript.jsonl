{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014T7ArnM574KpsD23BdJ8Yx","type":"tool_result","content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}"}]},"parent_tool_use_id":null,"session_id":"90bc205d-424f-425b-9c9d-f4fa651c10ee","uuid":"0a99e734-d670-484b-84cd-5ec117dbaa7e","timestamp":"2026-09-03T22:52:58.688Z","tool_use_result":{"content":"{\"content\":\"# Changelog\\n\\n## 2.4.0\\n\\n- Added calendar-aware scheduling (business days, holidays).\\n- Exponential back-off is now capped at 30 seconds.\\n- Dropped support for Node 16.\\n- Fixed a jitter bug that could schedule a job in the past.\\n\\n## 2.3.1\\n\\n- Fixed a memory leak in the job registry.\\n\"}","structuredContent":{"content":"# Changelog\n\n## 2.4.0\n\n- Added calendar-aware scheduling (business days, holidays).\n- Exponential back-off is now capped at 30 seconds.\n- Dropped support for Node 16.\n- Fixed a jitter bug that could schedule a job in the past.\n\n## 2.3.1\n\n- Fixed a memory leak in the job registry.\n"}}}
